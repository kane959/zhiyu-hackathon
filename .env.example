# Environment variables for Zhiyu.
# The process reads the environment directly; it does not parse this file.
# Local: set variables in the shell, or keep using the defaults.
# Server: install -m 600 this file as /etc/zhiyu.env and point systemd at it.

# Database file. On the server this must be an ABSOLUTE path inside the
# systemd ReadWritePaths (/srv/zhiyu/var): the unit sets ProtectSystem=strict,
# so a relative "var/..." resolves under the read-only app directory and init fails.
# For local runs, delete this line to use <repo>/var/zhiyu.sqlite3.
ZHIYU_DB=/srv/zhiyu/var/zhiyu.sqlite3

# Loopback port. Keep the 127.0.0.1 binding and put a TLS proxy in front.
ZHIYU_PORT=4173

# Listen address. 127.0.0.1 means only the local machine and the reverse
# proxy can reach it. 0.0.0.0 exposes the port to the network; only use it
# for a temporary device test, and add the reachable addresses to
# ZHIYU_HOSTS below or every request gets a 403.
ZHIYU_HOST=127.0.0.1

# Host header allowlist, comma separated, hostnames only (no scheme or port).
ZHIYU_HOSTS=localhost,127.0.0.1

# Public origin used for Origin checks, e.g. https://zhiyu.example.com
ZHIYU_PUBLIC_ORIGIN=

# 1 when a trusted reverse proxy sets X-Forwarded-For. Never enable on a directly exposed port.
ZHIYU_TRUST_PROXY=0

# 1 when served over HTTPS; adds Secure to cookies.
ZHIYU_SECURE_COOKIE=0

# Per-minute write caps.
ZHIYU_RATE_READER=30
ZHIYU_RATE_DEV=120
ZHIYU_RATE_CLAIM=5

# Per-minute read cap (in-memory, resets on restart).
ZHIYU_RATE_READ=600

# 1 seeds one demo workspace and writes var/DEMO_CODE (mode 600).
ZHIYU_DEMO=0

# Shown by /api/health; use git rev-parse --short HEAD plus a build time.
ZHIYU_BUILD=dev

# 1 writes one access line per request to stderr (journald under systemd).
ZHIYU_ACCESS_LOG=0

# Days of match runs to keep when scripts/prune.py runs. Runs behind a published
# card are always kept, whatever their age.
ZHIYU_RUN_RETENTION_DAYS=90

# TZ=Asia/Shanghai
